# Copy to .env.local or configure these values in the deployment provider.
POSTGRES_URL=postgresql://user:password@host:5432/database
PROCTOR_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
EXAM_LINK_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-a-long-admin-key
